<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Survey mockups</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "Segoe UI", "Inter", Roboto, Arial, sans-serif;
    color: #111827;
    background: #FFFFFF;
    -moz-osx-font-smoothing: grayscale;
  }
  .shot { width: 1250px; padding: 14px; background: #FFFFFF; }
  .frame {
    border: 1px solid #E7E9EE;
    border-radius: 20px;
    background: #FFFFFF;
    padding: 26px 30px 30px;
    box-shadow: 0 1px 2px rgba(16,24,40,.04);
  }
  h1.title { font-size: 25px; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 20px; }

  .s2-context {
    color: #92400E; font-size: 13px; font-weight: 800;
    letter-spacing: .08em; text-transform: uppercase; margin-bottom: 8px;
  }
  .shot[id^="s2_"] h1.title { margin-bottom: 16px; }

  /* Badges */
  .badge {
    display: inline-block;
    padding: 6px 18px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    color: #FFFFFF;
    line-height: 1.2;
  }
  .badge.vertex { background: #B45309; }
  .badge.beacon { background: #0F766E; }
  .badge.atlas  { background: #7C3AED; }

  /* Stage 2 candidate cards */
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .cand-card {
    border: 1px solid #E5E7EB;
    border-radius: 16px;
    background: #FBFBFC;
    padding: 18px 20px 16px;
    display: flex; flex-direction: column; align-items: center; gap: 9px;
  }
  .org-role {
    color: #6B7280; font-size: 12px; font-weight: 800;
    letter-spacing: .07em; text-transform: uppercase;
  }
  .cand-id {
    font-family: Consolas, "Courier New", monospace;
    font-size: 15px; color: #4B5563; letter-spacing: 0.02em;
  }
  .cand-avatar {
    width: 92px; height: 92px; border-radius: 50%; overflow: hidden;
    border: 2px solid #D1D5DB; background: #F0F0F0;
  }
  .cand-avatar img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; width: 100%; margin-top: 10px; }
  .tile {
    background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 12px;
    padding: 13px 18px; text-align: left;
  }
  .tile .lbl { font-size: 13px; color: #6B7280; margin-bottom: 4px; }
  .tile .val { font-size: 20px; font-weight: 800; }
  .tile .val.unknown { color: #9CA3AF; font-style: italic; font-weight: 600; }

  /* Slider */
  .caption { text-align: center; color: #6B7280; font-size: 15px; margin: 20px 0 6px; }
  .slider { margin-top: 14px; }
  .anchors { display: flex; justify-content: space-between; font-size: 15px; font-weight: 600; color: #111827; margin-bottom: 8px; }
  .track-wrap { position: relative; padding-top: 32px; }
  .bubble {
    position: absolute; top: 0; transform: translateX(-50%);
    background: #111827; color: #FFFFFF; font-weight: 700; font-size: 13px;
    padding: 4px 11px; border-radius: 999px; white-space: nowrap;
  }
  .track { position: relative; height: 8px; border-radius: 999px; background: #E5E7EB; }
  .fill { position: absolute; left: 0; top: 0; height: 8px; border-radius: 999px; background: #2563EB; }
  .fill.pink { background: #EC4899; }
  .ticks { position: relative; height: 18px; margin-top: 7px; font-size: 13px; color: #6B7280; }
  .ticks span { position: absolute; transform: translateX(-50%); }
  .ticks span.first { left: 0 !important; transform: none; }
  .ticks span.last { left: auto !important; right: 0; transform: none; }
  .preview { margin-top: 12px; font-size: 16px; color: #111827; }
  .preview b { font-weight: 800; }

  /* Evaluator layout */
  .grid3 { display: grid; grid-template-columns: 1fr 1.08fr 1.08fr; gap: 20px; align-items: stretch; }
  .endorser-card {
    position: relative; overflow: hidden;
    border: 1px solid #E5E7EB; border-radius: 16px;
    padding: 30px 18px 24px;
    display: flex; flex-direction: column; align-items: center; gap: 15px;
  }
  .endorser-card .accent { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; }
  .endorser-card.man { background: #EFF6FF; }
  .endorser-card.man .accent { background: #3B82F6; }
  .endorser-card.woman { background: #FDF2F8; }
  .endorser-card.woman .accent { background: #EC4899; }
  .avatar { width: 150px; height: 150px; border-radius: 50%; overflow: hidden; margin: 6px 0 4px; background: #F0F0F0; }
  .man .avatar { border: 3px solid #2563EB; box-shadow: 0 0 0 6px #BFDBFE; }
  .woman .avatar { border: 3px solid #DB2777; box-shadow: 0 0 0 6px #FBCFE8; }
  .avatar svg { display: block; width: 100%; height: 100%; }
  .avatar img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .role-pill { padding: 5px 17px; border-radius: 999px; font-weight: 700; font-size: 16px; }
  .man .role-pill { background: #DBEAFE; color: #1E40AF; }
  .woman .role-pill { background: #FCE7F3; color: #9D174D; }
  .endorser-id { font-family: Consolas, "Courier New", monospace; font-size: 13px; color: #374151; }

  .mid-card, .conf-card {
    border: 1px solid #E5E7EB; border-radius: 16px; background: #FFFFFF; padding: 24px;
  }
  .mid-card { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .mid-card h2 { font-size: 20px; font-weight: 800; margin-top: 8px; }
  .mid-card .id-lbl { font-size: 13px; color: #6B7280; margin-top: 8px; }
  .mid-card .id-val { font-family: Consolas, "Courier New", monospace; font-size: 24px; font-weight: 700; }
  .conf-card .lbl { font-size: 14px; color: #6B7280; margin-bottom: 14px; }
  .conf-track { position: relative; height: 10px; border-radius: 999px; background: #E5E7EB; }
  .conf-fill { position: absolute; left: 0; top: 0; height: 10px; border-radius: 999px; }
  .conf-fill.blue { background: #3B82F6; }
  .conf-fill.pink { background: #EC4899; }
  .conf-text { margin-top: 14px; font-size: 17px; color: #111827; }

  .block-card {
    border: 1px solid #E5E7EB; border-radius: 16px; background: #FFFFFF;
    padding: 22px 26px 24px; margin-top: 20px;
  }
  .block-card h2 { font-size: 21px; font-weight: 800; margin-bottom: 14px; }
  .wager-line { margin-top: 12px; font-size: 16px; }
  .payout-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 14px; }
  .payout-tiles .tile { padding: 14px 20px; }
  .payout-tiles .tile .lbl { font-size: 14px; }
  .payout-tiles .tile .val { font-size: 24px; }

  /* Outcome band */
  .band {
    border: 1px solid #E5E7EB; border-radius: 16px; background: #FBFBFC;
    padding: 18px 26px; margin-top: 20px;
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
  }
  .band .b-lbl { font-size: 14px; color: #6B7280; }
  .band .b-amt { font-size: 34px; font-weight: 800; margin: 2px 0; }
  .band .b-txt { font-size: 17px; }
  .pill-correct {
    background: #E1EFE7; color: #22684A; border: 1px solid #BFDCCB;
    padding: 8px 18px; border-radius: 999px; font-weight: 700; font-size: 16px; white-space: nowrap;
  }
  .wager-note { margin-top: 18px; margin-bottom: 8px; font-size: 15px; }

  /* Allocation */
  .intro { font-size: 15px; color: #374151; margin-bottom: 6px; }
  .alloc-block {
    border: 1px solid #E5E7EB; border-radius: 16px; background: #FFFFFF;
    padding: 20px 26px; margin-top: 16px;
    display: grid; grid-template-columns: 210px 1fr; gap: 28px; align-items: center;
  }
  .alloc-left {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    border-right: 1px solid #F1F2F4; padding-right: 20px;
  }
  .mini-avatar { width: 66px; height: 66px; border-radius: 50%; overflow: hidden; background: #F0F0F0; }
  .mini-avatar.man-mini { border: 3px solid #2563EB; box-shadow: 0 0 0 4px #BFDBFE; }
  .mini-avatar svg { display: block; width: 100%; height: 100%; }
  .role-pill.small { font-size: 13px; padding: 3px 12px; background: #DBEAFE; color: #1E40AF; }
  .alloc-q { font-size: 18px; font-weight: 700; margin-bottom: 10px; }
  .chip {
    display: inline-block; margin-top: 12px;
    background: #E1EFE7; color: #22684A; font-weight: 700; font-size: 14px;
    padding: 5px 13px; border-radius: 999px;
  }
</style>
</head>
